{
  "name": "wechat-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "build": "bun src/build.ts",
    "check": "tsc --noEmit && tsc -p src/native/tsconfig.json",
    "test": "bun test tests",
    "lint": "biome check src tests scripts/adb-login.ts scripts/download-client.ts biome.json package.json tsconfig.json",
    "format": "biome check --write src tests scripts/adb-login.ts scripts/download-client.ts biome.json package.json tsconfig.json"
  },
  "trustedDependencies": [
    "frida"
  ],
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "fast-xml-parser": "^5.11.2",
    "frida": "17.23.3",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "silk-wasm": "^3.7.1",
    "zod": "^4.6.7",
    "wechat-rpc": "workspace:*",
    "@trpc/server": "11.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/frida-gum": "^19.12.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
