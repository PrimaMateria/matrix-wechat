{
  "name": "matrix-wechat-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "check": "tsc --noEmit",
    "lint": "biome check src scripts package.json tsconfig.json biome.json",
    "format": "biome check --write src scripts package.json tsconfig.json biome.json",
    "test:e2e": "bun scripts/e2e.ts"
  },
  "dependencies": {
    "@vector-im/matrix-bot-sdk": "0.10.1-element.0",
    "matrix-appservice-bridge": "12.0.1",
    "zod": "^4.6.7",
    "wechat-rpc": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.14",
    "@types/express": "^4.17.25",
    "typescript": "^7.0.2"
  }
}
